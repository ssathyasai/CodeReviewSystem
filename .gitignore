# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest & Test Caches
.pytest_cache/
.coverage
htmlcov/

# Environment variables
.env
.env.local
.env.*.local

# Node.js / React
node_modules/
frontend/node_modules/
dist-ssr/
*.local

# Runtime Data & Temporary Files
data/workspaces/*
!data/workspaces/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/local_db/*
!data/local_db/.gitkeep
data/test_git_clone/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
