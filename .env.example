# =============================================================================
# AI Code Review & Quality Assurance System - Environment Variables
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database Configuration
# Provide a MongoDB Atlas connection string, or leave empty/unreachable to automatically use the high-performance local document store.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=codereview_db

# AI Provider Configuration ("local", "groq", "openai", "gemini", "ollama")
AI_PROVIDER=local

# Groq Cloud AI (High speed cloud LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=

# Ollama (Local Self-Hosted)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest

# Optional GitHub Personal Access Token (for higher API rate limits when scanning public repositories)
GITHUB_TOKEN=

# DAST & Security Scanner Limits
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=200
MAX_SCAN_TIME_SECONDS=300
DAST_TIMEOUT_SECONDS=60
DAST_ALLOW_LOCAL_TARGETS=true
